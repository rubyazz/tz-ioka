# Template for .env — run `make up` (it copies this file if .env is missing)
# or copy manually:  cp .env.example .env
# Hostnames below are docker-compose SERVICE names; use localhost when
# running the app outside compose. No real secrets here by design — change
# JWT_SECRET for anything beyond local development.

# --- Application ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/travel

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://ioka:ioka@postgres:5432/ioka_travel
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://ioka:ioka@rabbitmq:5672/%2F

# --- Search cache / sessions ---
SEARCH_SESSION_TTL_SECONDS=900
LOCATIONS_CACHE_TTL_SECONDS=3600
SEARCH_DEADLINE_SECONDS=30

# --- Ticket PDF pipeline ---
TICKET_QUEUE=ticket.generation
TICKET_DLQ=ticket.generation.dlq
TICKET_FALLBACK_SYNC=true
TICKET_STORAGE_DIR=/data/tickets

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Avia content provider ---
PROVIDER=mock
PROVIDER_TIMEOUT_SECONDS=8
# Simulated provider latency; tests set both to 0
MOCK_LATENCY_MIN_MS=1500
MOCK_LATENCY_MAX_MS=3000

# --- Demo seed (created on startup if missing) ---
SEED_DEMO_DATA=true
DEMO_AGENT_USERNAME=agent
DEMO_AGENT_PASSWORD=agent123
DEMO_AGENT_BALANCE=10000.00
